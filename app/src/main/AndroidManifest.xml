
name: Build RinBridge APK

on:
  workflow_dispatch:
  push:
    branches:
      - main

jobs:
  build:
    runs-on: ubuntu-latest

    steps:
      # 1. Ambil source code
      - name: Checkout repository
        uses: actions/checkout@v4

      # 2. Setup Java 17
      - name: Setup JDK 17
        uses: actions/setup-java@v4
        with:
          distribution: temurin
          java-version: 17

      # 3. Setup Gradle
      - name: Setup Gradle
        uses: gradle/actions/setup-gradle@v4

      # 4. Periksa kewujudan Manifest
      - name: Check Manifest File
        run: |
          echo "Checking AndroidManifest.xml..."

          if [ ! -f app/src/main/AndroidManifest.xml ]; then
            echo "ERROR: AndroidManifest.xml not found!"
            exit 1
          fi

          echo "Manifest file found."

      # 5. Paparkan kandungan Manifest
      - name: Display Manifest
        run: |
          echo "===== MANIFEST CONTENT ====="
          cat -A app/src/main/AndroidManifest.xml

      # 6. Validate XML
      - name: Validate Manifest XML
        run: |
          sudo apt-get update
          sudo apt-get install -y libxml2-utils

          xmllint --noout app/src/main/AndroidManifest.xml

          echo "Manifest XML is valid!"

      # 7. Build APK
      - name: Build APK
        run: |
          gradle assembleDebug --stacktrace

      # 8. Upload APK
      - name: Upload APK
        uses: actions/upload-artifact@v4
        with:
          name: RinBridge-debug-APK
          path: app/build/outputs/apk/debug/*.apk
          if-no-files-found: error
